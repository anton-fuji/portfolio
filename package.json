    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.2.0",
    "three": "^0.185.0",
    "vanta": "^0.5.24",
    "vike": "0.4.263",
    "vike-react": "^0.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^7.0.2",
    "vike": "^0.4.229",
