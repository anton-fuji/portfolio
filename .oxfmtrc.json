{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "package.json",
    "**/*.js",
    "tsconfig.app.json",
    "tsconfig.node.json"
  ],
  "useTabs": false,
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": false
}
